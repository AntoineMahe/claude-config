# AppArmor profile for Claude Code CLI
# Minimal strict-enforce: broad dev access with targeted denies
#
# Claude Code is a dev tool that needs wide filesystem access.
# This profile adds a kernel-enforced layer on top of Claude's own
# settings.json deny rules — which Claude can modify, but AppArmor it cannot.
#
# Install: sudo cp apparmor/claude-code /etc/apparmor.d/claude-code
#          sudo apparmor_parser -r /etc/apparmor.d/claude-code
# Remove:  sudo apparmor_parser -R /etc/apparmor.d/claude-code
#          sudo rm /etc/apparmor.d/claude-code
# Debug:   sudo aa-complain /etc/apparmor.d/claude-code
#          journalctl -k | grep DENIED

abi <abi/4.0>,

include <tunables/global>

# Where the rootless Docker daemon's socket lives. Several defaults are
# listed because the service account's name is a local choice; a rule that
# names a directory which does not exist on this machine is inert, so
# shipping more than one costs nothing.
#
# To add a path without editing this file, drop a line into
# /etc/apparmor.d/tunables/claude-code.d/local :
#
#     @{CLAUDE_DOCKER_DIRS}+=/srv/myaccount
#
# Use += , not = : plain assignment replaces the defaults instead of
# extending them, which silently drops the socket you were already using.
@{CLAUDE_DOCKER_DIRS}=/srv/claude-docker /srv/docker
include if exists <tunables/claude-code.d>

# attach_disconnected: needed to reach the rootless Docker socket, which is
# bound in another mount namespace (see the Docker section below).
profile claude-code @{HOME}/.local/share/claude/versions/* flags=(enforce, attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>

  # =============================================================
  # DENY RULES (always win over allow rules)
  # =============================================================

  # --- Universal: system-level secrets ---
  deny @{HOME}/.ssh/** rwlk,
  deny @{HOME}/.gnupg/** rwlk,
  deny @{HOME}/.local/share/keyrings/** rwlk,
  deny @{HOME}/.bash_history rwlk,

  # --- Per-machine: customize these for your setup ---
  # deny @{HOME}/Documents/finances/** rwlk,
  # deny @{HOME}/private/** rwlk,
  # deny @{HOME}/.config/some-app/** rwlk,
  include if exists <local/claude-code>

  # --- No privilege escalation ---
  deny /usr/bin/sudo x,
  deny /usr/bin/su x,
  deny /usr/bin/pkexec x,
  deny /usr/bin/doas x,
  deny /usr/sbin/aa-* x,
  deny /usr/sbin/apparmor_parser x,

  # Nix store paths are content-addressed hashes, so the absolute-path
  # denies above don't catch a nixpkgs-provided sudo/su/pkexec/apparmor
  # tool. Close the same gap there.
  deny /nix/store/*/bin/sudo x,
  deny /nix/store/*/bin/su x,
  deny /nix/store/*/bin/pkexec x,
  deny /nix/store/*/bin/aa-* x,
  deny /nix/store/*/sbin/aa-* x,
  deny /nix/store/*/sbin/apparmor_parser x,

  # =============================================================
  # CLAUDE CODE RUNTIME
  # =============================================================

  # Binary and install directory
  @{HOME}/.local/share/claude/** r,
  @{HOME}/.local/share/claude/versions/* mr,
  @{HOME}/.local/bin/claude r,

  # Claude config (settings, history, credentials, memory, tasks)
  @{HOME}/.claude/ r,
  owner @{HOME}/.claude/** rwk,

  # Process info (memory stats, etc.)
  @{PROC}/@{pid}/** r,
  @{PROC}/sys/** r,

  # =============================================================
  # BROAD DEV ACCESS
  # =============================================================

  # Read: entire filesystem (DAC permissions still apply)
  / r,
  /** r,

  # Write: user-owned files in home + tmp.
  # `k` (file locking) is needed by sqlite-backed tools, e.g. pre-commit's
  # ~/.cache/pre-commit/db.db — without it they fail with "database is locked".
  owner @{HOME}/** wk,
  /tmp/** rwkl,
  /tmp/ r,

  # Execute: common dev tools — inherit this profile.
  # The HOME rule is owner-scoped, so files dropped by another user are still
  # blocked. It covers ephemeral tool environments that a narrow allowlist
  # cannot anticipate: pre-commit's ~/.cache/pre-commit/repo*/{py,node,ruby}_env-*,
  # project .venv/.tox, node_modules/.bin, pyenv/uv/pipx/nvm/pnpm/cargo,
  # docker CLI plugins under ~/.docker/cli-plugins, etc.
  /usr/bin/** ix,

  # Ubuntu 25.10+ replaced GNU coreutils with the Rust uutils build. /usr/bin/ls,
  # cat, head, tail, cut, sort, wc, basename ... are now symlinks to a multi-call
  # binary under /usr/lib/cargo/bin/coreutils/, and AppArmor matches the RESOLVED
  # target, not the symlink. The /usr/lib/** rule below grants r+m but not x, so
  # without this line every coreutil is denied while grep/sed/awk/find (still GNU,
  # still in /usr/bin) keep working -- a confusing half-broken shell.
  /usr/lib/cargo/bin/coreutils/** ix,
  /usr/local/bin/** ix,
  /bin/** ix,
  /snap/bin/** ix,
  /opt/** ix,
  /usr/libexec/** ix,
  # git dispatches subcommands by exec'ing /usr/lib/git-core/git-<cmd>
  # (worktree add/remove spawn git-branch, git-symbolic-ref, ...);
  # without this only in-process builtins work.
  /usr/lib/git-core/** ix,
  owner @{HOME}/** ix,

  # Nix (multi-user store). Root-owned and immutable — this profile can
  # exec what's already built, but can't write new store paths itself;
  # installs still go through the daemon (see socket rule below).
  /nix/store/** ix,

  # =============================================================
  # NETWORK (Anthropic API, git, docker, etc.)
  # =============================================================

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  network unix dgram,

  # =============================================================
  # DEVICES & LIBRARIES
  # =============================================================

  /dev/null rw,
  /dev/urandom r,
  /dev/random r,
  /dev/tty rw,
  /dev/pts/* rw,

  # Nvidia GPU device nodes (nvidia-smi, CUDA, NVML-based tools).
  # Without these, NVML fails with an opaque "Unknown Error" rather
  # than a permission message, which is what made this hard to spot.
  /dev/nvidiactl rw,
  /dev/nvidia-uvm rw,
  /dev/nvidia-uvm-tools rw,
  /dev/nvidia-modeset rw,
  /dev/nvidia[0-9]* rw,
  /dev/nvidia-caps/* r,

  # Rootful container runtime sockets are deliberately NOT allowed: the
  # user is in the docker group, so docker.sock access is root-equivalent
  # (docker run --privileged -v /:/host bypasses this entire profile).
  deny /{var/,}run/docker.sock rw,
  deny /{var/,}run/podman/podman.sock rw,

  # Rootless daemon of a dedicated service account: NOT root-equivalent,
  # because container "root" maps to that unprivileged account rather than
  # to real root. Needs attach_disconnected (the socket is bound in
  # rootlesskit's mount namespace). Paths come from @{CLAUDE_DOCKER_DIRS}
  # at the top of this file; see the README to add your own.
  @{CLAUDE_DOCKER_DIRS}/ r,
  @{CLAUDE_DOCKER_DIRS}/docker.sock rw,

  # Nix daemon socket (multi-user install) — same reasoning as above.
  /nix/var/nix/daemon-socket/socket rw,

  /usr/lib/** rm,
  /lib/** rm,
  /lib64/** rm,
}
